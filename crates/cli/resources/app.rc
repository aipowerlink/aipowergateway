#include <winres.h>

// AIPowerLink 版本信息资源（消除杀软误报 + 正常元数据）

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "AIPowerLink\0"
            VALUE "FileDescription", "AIPowerLink LAN Compute Share Gateway\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "aipowerlink\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 AIPowerLink. AGPL-3.0\0"
            VALUE "OriginalFilename", "aipowergateway.exe\0"
            VALUE "ProductName", "AIPowerLink\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END